# ============================================================================
# ShopCart - Variables de Entorno de Ejemplo (.env.example)
# Copie este archivo a .env y ajuste los valores según su entorno local.
# ============================================================================

# --- Base de Datos (Microsoft SQL Server 2019/2022) ---
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=ChangeMe_StrongPass!2026
DB_NAME=ShopCartDB
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# --- Backend API (Node.js 24 + Express + TypeScript) ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Autenticación JWT (RF-01) ---
JWT_ACCESS_SECRET=replace_with_64_char_random_hex_access_secret_key
JWT_REFRESH_SECRET=replace_with_64_char_random_hex_refresh_secret_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
BCRYPT_SALT_ROUNDS=10

# --- Parámetros de Negocio ---
CHECKOUT_RESERVATION_MINUTES=15
ABANDONED_CART_THRESHOLD_MINUTES=120
IVA_PERCENTAGE=12.00
